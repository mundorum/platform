# Mundorum platform — environment template. Copy to .env at the repository
# root (read by docker compose and by the shared server's settings.py).
# noid/.env is still read by the server as a dev fallback, and by noid's
# processing server when run bare from noid/.

# noid paths — read ONLY when running outside Docker (bare `manage.py
# runserver` / `uvicorn`). Under `docker compose` these plus PROCESSING_URL
# and SCENES_DIR are hardcoded in docker-compose.yml's `environment:` blocks
# and override whatever is set here. Relative paths are anchored at noid/.
COLLECTIONS_FILE=./collections.yaml
SCENE_PACKAGES_DIR=./storage/scene_packages
SHARED_RESOURCES_DIR=./storage/shared_resources

# Host ports published by docker-compose.yml (override to avoid clashes with
# other stacks). AUTHORING_PORT is still accepted as the old name of SERVER_PORT.
SERVER_PORT=8000
PROCESSING_PORT=8001

# Django — generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=dev-key-change-in-production
# Must be "false" in production
DEBUG=true
# Comma-separated list of hostnames Django will answer to (e.g. mundorum.example.org)
ALLOWED_HOSTS=*

# Postgres credentials (must match DATABASE_URL below). Avoid # @ : / in the
# password — they break DATABASE_URL parsing; `secrets.token_hex(12)` is safe.
POSTGRES_USER=noid
POSTGRES_PASSWORD=noid
POSTGRES_DB=noid

# One database shared by every subproject (Docker: host "db"; bare dev with
# dbms/docker-compose.yml: host "localhost")
DATABASE_URL=postgres://noid:noid@db:5432/noid

# noid: Processing Machine
PROCESSING_URL=http://localhost:8001
PROCESSING_API_KEY=dev-key-change-in-prod
SCENES_DIR=/tmp/noid_processing

# Google OAuth (shared sign-in for every subproject)
# Obtain GOOGLE_CLIENT_ID from Google Cloud Console → APIs & Services → Credentials.
# Authorized redirect URI: <origin>/auth/google/callback/
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# CORS: comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:8000

# CSRF: comma-separated list of trusted origins, each WITH scheme
# (e.g. https://mundorum.example.org). Required behind a reverse proxy —
# without it (and without SECURE_PROXY_SSL_HEADER, set unconditionally in
# settings.py) POSTs like the admin login fail CSRF verification. Leave empty
# for local dev over plain http://localhost.
CSRF_TRUSTED_ORIGINS=

# Seed: email that gets a manager pre-authorization on first deploy
# Run after migrate: python manage.py seed_initial_manager
INITIAL_MANAGER_EMAIL=your-admin@example.com

# LLM gateway — provider API keys do NOT go here. Put each key in its own
# file under secrets/ (secrets/groq_api_key, secrets/openrouter_api_key,
# secrets/mistral_api_key). See docs/llm-gateway.md.
LLM_DEFAULT_PROVIDER=groq
# Default model for the default provider; per-provider overrides below.
# `python manage.py llm_check <provider> --list-models` lists valid ids.
LLM_DEFAULT_MODEL=
GROQ_MODEL=
OPENROUTER_MODEL=
MISTRAL_MODEL=
# Sent to OpenRouter as HTTP-Referer (optional app attribution)
LLM_APP_URL=
# Per-user gateway calls per hour (0 = unlimited)
LLM_USER_CALLS_PER_HOUR=300
